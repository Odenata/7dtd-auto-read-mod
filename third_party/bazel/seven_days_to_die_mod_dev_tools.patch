+public class XUiC_LootContainer : XUiC_ItemStackGrid
+{
+    public ITileEntityLootable localTileEntity { get; set; }
+
+    public void SetSlots(ITileEntityLootable lootContainer, ItemStack[] stackList)
+    {
+        localTileEntity = lootContainer;
+        if (stackList == null || itemControllers == null) return;
+        var length = System.Math.Min(stackList.Length, itemControllers.Length);
+        for (var i = 0; i < length; i++)
+        {
+            var controller = itemControllers[i];
+            if (controller == null) continue;
+            var stack = stackList[i];
+            controller.ForceSetItemStack(stack == null || stack.IsEmpty() ? ItemStack.Empty : stack);
+        }
+    }
+
+    public void OnTileEntityChanged(ITileEntity te)
+    {
+        if (te is ITileEntityLootable lootable)
+        {
+            var items = ((TileEntityLootContainer)te).items;
+            SetSlots(lootable, items);
+        }
+    }
+}
