+public class ItemActionGainSkill : ItemActionBase
+{
+    public int ExecuteActionCalls;
+    public int AppliedSkillCalls;
+    public bool RequireNonEmptyStack;
+    public bool RequireEventParms;
+    public string[] SkillsToGain { get; set; }
+
+    public ItemActionData CreateModifierData(ItemInventoryData invData, int indexInEntityOfAction)
+    {
+        return new ItemActionData(invData, indexInEntityOfAction);
+    }
+
+    public void ExecuteAction(ItemActionData actionData, bool released)
+    {
+        ExecuteActionCalls++;
+        var hasReadableStack = !RequireNonEmptyStack || (actionData?.invData?.itemStack != null && actionData.invData.itemStack.count > 0);
+        var hasEventParams = !RequireEventParms || (actionData?.EventParms != null && object.ReferenceEquals(actionData.EventParms.ItemActionData, actionData));
+        if (hasReadableStack && hasEventParams)
+        {
+            AppliedSkillCalls++;
+            var skills = SkillsToGain;
+            var entity = actionData?.invData?.holdingEntity;
+            if (skills != null && entity?.Progression != null)
+            {
+                for (var i = 0; i < skills.Length; i++)
+                {
+                    var skill = skills[i];
+                    if (string.IsNullOrWhiteSpace(skill)) continue;
+                    var pv = entity.Progression.GetProgressionValue(skill);
+                    if (pv == null) continue;
+                    var next = System.Math.Min(pv.Level + 1, pv.CalculatedMaxLevel(entity));
+                    pv.Level = next;
+                    pv.level = next;
+                }
+            }
+        }
+    }
+}
+
+public class ItemActionLearnRecipe : ItemActionBase
+{
+    public string[] RecipesToLearn { get; set; }
+    public int ExecuteActionCalls;
+
+    public ItemActionData CreateModifierData(ItemInventoryData invData, int indexInEntityOfAction)
+    {
+        return new ItemActionData(invData, indexInEntityOfAction);
+    }
+
+    public void ExecuteAction(ItemActionData actionData, bool released)
+    {
+        ExecuteActionCalls++;
+        var recipes = RecipesToLearn;
+        if (recipes == null) return;
+        var player = actionData?.invData?.holdingEntity as EntityPlayer;
+        for (var i = 0; i < recipes.Length; i++)
+        {
+            if (!string.IsNullOrWhiteSpace(recipes[i]))
+                CraftingManager.Instance?.UnlockRecipe(recipes[i], player);
+        }
+    }
+}
