+public class ItemActionEat : ItemActionBase
+{
+    public bool SimulateInstantActionFailure;
+    public bool SimulateNoDecrement;
+    public bool ReturnFalseAfterInstantAction;
+    public bool SimulateOverDecrement;
+    public bool ConsumeEntireStack;
+    public System.Action<EntityAlive> AfterInstantActionHook;
+    public int ExecuteInstantActionCalls;
+    public int ExecuteActionCalls;
+    public int ConsumeCalls;
+
+    public ItemActionEat() { }
+
+    public ItemActionData CreateModifierData(ItemInventoryData invData, int indexInEntityOfAction)
+    {
+        return new ItemActionData(invData, indexInEntityOfAction);
+    }
+
+    public virtual void ExecuteAction(ItemActionData actionData, bool released)
+    {
+        ExecuteActionCalls++;
+        consume(actionData);
+    }
+
+    public virtual void consume(ItemActionData actionData)
+    {
+        ConsumeCalls++;
+        if (SimulateInstantActionFailure)
+        {
+            throw new System.InvalidOperationException("Simulated consume failure");
+        }
+
+        var stack = actionData?.invData?.itemStack;
+        if (!SimulateNoDecrement && stack != null && stack.count > 0)
+        {
+            stack.count--;
+        }
+    }
+
+    public virtual bool ExecuteInstantAction(EntityAlive ent, ItemStack stack, bool isHeldItem, XUiC_ItemStack stackController)
+    {
+        ExecuteInstantActionCalls++;
+        if (SimulateInstantActionFailure)
+        {
+            return false;
+        }
+
+        var stackToMutate = stackController?.ItemStack ?? stack;
+        if (!isHeldItem && ConsumeEntireStack && stackToMutate != null)
+        {
+            stackToMutate.count = 0;
+        }
+        else if (!isHeldItem && SimulateOverDecrement && stackToMutate != null)
+        {
+            stackToMutate.count = -1;
+        }
+        else if (!isHeldItem && !SimulateNoDecrement && stackToMutate != null && stackToMutate.count > 0)
+        {
+            stackToMutate.count--;
+        }
+
+        AfterInstantActionHook?.Invoke(ent);
+
+        return !ReturnFalseAfterInstantAction;
+    }
+}
