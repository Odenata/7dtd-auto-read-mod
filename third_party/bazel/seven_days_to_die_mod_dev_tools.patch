+public class Progression
+{
+    private readonly System.Collections.Generic.Dictionary<string, ProgressionValue> _values =
+        new System.Collections.Generic.Dictionary<string, ProgressionValue>(System.StringComparer.OrdinalIgnoreCase);
+
+    public ProgressionValue GetProgressionValue(string progressionName)
+    {
+        if (string.IsNullOrWhiteSpace(progressionName))
+        {
+            return null;
+        }
+
+        if (!_values.TryGetValue(progressionName, out var value))
+        {
+            value = new ProgressionValue { name = progressionName, Level = 0, level = 0 };
+            _values[progressionName] = value;
+        }
+
+        return value;
+    }
+
+    public System.Collections.Generic.List<ProgressionValue> ProgressionValueQuickList
+    {
+        get { return new System.Collections.Generic.List<ProgressionValue>(_values.Values); }
+    }
+}
+
+public class ProgressionValue
+{
+    public string name { get; set; }
+    public int Level { get; set; }
+    public int level { get; set; }
+    public float calculatedLevel { get; set; }
+    public int MaxLevelOverride { get; set; } = 100;
+    public int CalculatedLevel(EntityAlive _ea) => System.Math.Max(Level, level);
+    public int CalculatedMaxLevel(EntityAlive _ea) => MaxLevelOverride;
+}
