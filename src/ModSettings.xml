<?xml version="1.0" encoding="utf-8"?>
<ModSettings version="2">
  <!-- World: synced server to clients when Gears is installed. Enforcement knobs. -->
  <World>
    <Category name="Behavior" displayKey="armWorldBehavior">
      <Description key="armWorldBehaviorTip" />
      <Switch name="Enabled" displayKey="armEnabled" type="bool" defaultValue="true">
        <Description key="armEnabledWorldTip" />
      </Switch>
      <Switch name="SkipAlreadyRead" displayKey="armSkipAlreadyRead" type="bool" defaultValue="false">
        <Description key="armSkipAlreadyReadTip" />
      </Switch>
      <Switch name="ReadOnInventoryAdd" displayKey="armReadOnInventoryAdd" type="bool" defaultValue="false">
        <Description key="armReadOnInventoryAddTip" />
      </Switch>
      <Switch name="Books" displayKey="armBooks" type="bool" defaultValue="true">
        <Description key="armBooksTip" />
      </Switch>
      <Switch name="Magazines" displayKey="armMagazines" type="bool" defaultValue="true">
        <Description key="armMagazinesTip" />
      </Switch>
      <Switch name="Schematics" displayKey="armSchematics" type="bool" defaultValue="true">
        <Description key="armSchematicsTip" />
      </Switch>
    </Category>
  </World>

  <!-- Global: this client only (Esc / main menu Mods settings). -->
  <Global>
    <Tab name="Client" displayKey="armTabClient" tooltipKey="armTabClientTip">
      <Category name="Debug" displayKey="armCategoryDebug">
        <Description key="armCategoryDebugTip" />
        <Switch name="DebugMode" displayKey="armDebugMode" type="bool" defaultValue="false">
          <Description key="armDebugModeTip" />
        </Switch>
      </Category>
      <Category name="Audio" displayKey="armCategoryAudio">
        <Description key="armCategoryAudioTip" />
        <Switch name="PlayReadSounds" displayKey="armPlayReadSounds" type="bool" defaultValue="true">
          <Description key="armPlayReadSoundsTip" />
        </Switch>
        <Switch name="PlayBookSetCompleteSound" displayKey="armPlayBookSetCompleteSound" type="bool" defaultValue="true">
          <Description key="armPlayBookSetCompleteSoundTip" />
        </Switch>
      </Category>
      <Category name="Visualization" displayKey="armCategoryVisualization">
        <Description key="armCategoryVisualizationTip" />
        <Switch name="Enabled" displayKey="armVizEnabled" type="bool" defaultValue="true">
          <Description key="armVizEnabledTip" />
        </Switch>
        <Switch name="ShowReadEffects" displayKey="armShowReadEffects" type="bool" defaultValue="true">
          <Description key="armShowReadEffectsTip" />
        </Switch>
        <Slider name="MaxVisible" displayKey="armVizMaxVisible" type="int" defaultValue="8">
          <Description key="armVizMaxVisibleTip" />
          <Range increment="1" minValue="1" maxValue="32" />
        </Slider>
        <Color name="ColorBook" displayKey="armColorBook" defaultValue="0,204,64">
          <Description key="armColorBookTip" />
        </Color>
        <Color name="ColorMagazine" displayKey="armColorMagazine" defaultValue="0,102,255">
          <Description key="armColorMagazineTip" />
        </Color>
        <Color name="ColorRecipe" displayKey="armColorRecipe" defaultValue="230,204,0">
          <Description key="armColorRecipeTip" />
        </Color>
        <Color name="ColorSchematic" displayKey="armColorSchematic" defaultValue="255,0,255">
          <Description key="armColorSchematicTip" />
        </Color>
      </Category>
    </Tab>
  </Global>
</ModSettings>
