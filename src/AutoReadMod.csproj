<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AutoReadMod</AssemblyName>
    <RootNamespace>AutoReadMod</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' != ''">
    <!-- 7 Days to Die game assemblies (local install) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SevenDtdInstallDir)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="InControl">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\InControl.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' == ''">
    <!-- IDE/MSBuild fallback; Bazel fetches pinned mocks and HarmonyX itself -->
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\UnityEngine-CoreModule-Mock.csproj" />
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\Assembly-CSharp-Mock.csproj" />
    <Reference Include="0Harmony">
      <HintPath>$(SevenDtdDevToolsDir)\third_party\harmony\lib\net472\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="InControl">
      <HintPath>..\third_party\gearsapi\lib\net472\InControl.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="GearsAPI">
      <HintPath>..\third_party\gearsapi\lib\net472\GearsAPI.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="ModApi.cs" />
    <Compile Include="ModContentRoot.cs" />
    <Compile Include="ModConfig.cs" />
    <Compile Include="GearsModApi.cs" />
    <Compile Include="ContainerOpenPatch.cs" />
    <Compile Include="BagOpenPatch.cs" />
    <Compile Include="BundleOpenPatch.cs" />
    <Compile Include="InventoryAddPatch.cs" />
    <Compile Include="GameReflection.cs" />
    <Compile Include="AutoReader.cs" />
    <Compile Include="AutoReadVisualizationEvent.cs" />
    <Compile Include="AutoReadVisualizationQueue.cs" />
    <Compile Include="AutoReadVisualizationOverlay.cs" />
    <None Include="ModInfo.xml" />
    <None Include="Config.xml" />
    <None Include="ModSettings.xml" />
    <None Include="Config\Localization.csv" />
  </ItemGroup>

</Project>
