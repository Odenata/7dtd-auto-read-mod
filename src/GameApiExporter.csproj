<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GameApiExporter</AssemblyName>
    <RootNamespace>GameApiExporter</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' != ''">
    <!-- 7 Days to Die game assemblies (local install) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SevenDtdInstallDir)\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(SevenDtdInstallDir)' == ''">
    <!-- Mocks (hermetic builds/tests without a live game install) -->
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\UnityEngine-CoreModule-Mock.csproj" />
    <ProjectReference Include="$(SevenDtdDevToolsDir)\mocks\Assembly-CSharp-Mock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ModApi.cs" />
    <Compile Include="ModConfig.cs" />
    <Compile Include="RuntimeApiExporter.cs" />
    <None Include="ModInfo.xml" />
    <None Include="Config.xml" />
  </ItemGroup>

</Project>
